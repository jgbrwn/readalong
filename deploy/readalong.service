[Unit]
Description=Readalong private audiobook reader
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=@SERVICE_USER@
Group=@SERVICE_USER@
WorkingDirectory=@APP_DIR@
EnvironmentFile=@APP_DIR@/.env
UnsetEnvironment=GROQ_API_KEY OPENROUTER_API_KEY CLOUDFLARE_API_TOKEN R2_ACCOUNT_ID R2_ACCESS_KEY_ID R2_SECRET_ACCESS_KEY R2_ENDPOINT
ExecStart=@APP_DIR@/bin/readalong
Restart=on-failure
RestartSec=3
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ReadWritePaths=@APP_DIR@/data
ReadWritePaths=@APP_DIR@/.tools
LimitNOFILE=65536

[Install]
WantedBy=multi-user.target
